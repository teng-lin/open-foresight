+int litert_lm_session_config_add_stop_token_sequence(
+    LiteRtLmSessionConfig* config, const int32_t* token_ids, size_t count) {
+  if (!config || !config->config || (count != 0 && !token_ids)) return 1;
+  if (count == 0) return 0;
+  config->config->GetMutableStopTokenIds().emplace_back(token_ids,
+                                                       token_ids + count);
+  return 0;
+}
