--- a/c/engine_test.cc
+++ b/c/engine_test.cc
@@ -400,6 +400,34 @@ TEST(EngineCTest, CreateSessionConfigWithSamplerParams) {
   EXPECT_EQ(params.seed(), 1234);
 }
 
+TEST(EngineCTest, AppendStopTokenSequencesBeforeConversationConfigCopy) {
+  SessionConfigPtr config(litert_lm_session_config_create(),
+                          &litert_lm_session_config_delete);
+  const int32_t first[] = {101, 202};
+  const int32_t second[] = {303};
+  const auto previous = config->config->GetStopTokenIds().size();
+  EXPECT_EQ(litert_lm_session_config_add_stop_token_sequence(
+                config.get(), first, 2), 0);
+  EXPECT_EQ(litert_lm_session_config_add_stop_token_sequence(
+                config.get(), nullptr, 0), 0);
+  EXPECT_EQ(litert_lm_session_config_add_stop_token_sequence(
+                config.get(), second, 1), 0);
+  const auto& sequences = config->config->GetStopTokenIds();
+  ASSERT_EQ(sequences.size(), previous + 2);
+  EXPECT_EQ(sequences[previous], (std::vector<int>{101, 202}));
+  EXPECT_EQ(sequences[previous + 1], (std::vector<int>{303}));
+  EXPECT_EQ(litert_lm_session_config_add_stop_token_sequence(
+                nullptr, first, 2), 1);
+  EXPECT_EQ(litert_lm_session_config_add_stop_token_sequence(
+                config.get(), nullptr, 1), 1);
+  auto* conversation_config = litert_lm_conversation_config_create();
+  litert_lm_conversation_config_set_session_config(conversation_config,
+                                                  config.get());
+  EXPECT_EQ(conversation_config->session_config->GetStopTokenIds(),
+            sequences);
+  litert_lm_conversation_config_delete(conversation_config);
+}
