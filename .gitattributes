# Patch files contain significant trailing whitespace (blank context lines,
# nested patches), so exclude them from `git diff --check`.
*.patch -whitespace

# Preserve the frozen collector CSV bytes while checking ordinary whitespace.
tests/fixtures/doc-ci/2026-10-20-ci-review-baseline.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
