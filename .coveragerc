[run]
branch = True
patch = subprocess
relative_files = True
source =
    tools
    packaging
    native
omit =
    */tools/test_*.py
    */tools/original_query_oracle/test_*.py

[report]
precision = 2
fail_under = 95
show_missing = True
skip_empty = True
omit =
    */tools/test_*.py
    */tools/original_query_oracle/test_*.py

[html]
directory = coverage/python/html

[xml]
output = coverage/python/coverage.xml

[lcov]
output = coverage/python/lcov.info
