[run]
branch = True
relative_files = True
source =
    tools
    packaging
omit =
    tools/test_*.py
    tools/original_query_oracle/test_*.py

[report]
precision = 2
fail_under = 48.70
show_missing = True
skip_empty = True

[html]
directory = coverage/python/html

[xml]
output = coverage/python/coverage.xml

[lcov]
output = coverage/python/lcov.info
