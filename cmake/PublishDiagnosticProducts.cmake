cmake_minimum_required(VERSION 3.20)
# Runs only after both linked targets and the current toolchain check succeed.
# Inspect bytes without loading either product into the build process.
file(WRITE "${DIAGNOSTIC_STATE}" "{\"schema\":1,\"available\":false}\n")
if(NOT DIAGNOSTIC_NATIVE_ID MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Invalid diagnostic product identity")
endif()
string(LENGTH "${DIAGNOSTIC_NATIVE_ID}" _identity_length)
if(NOT _identity_length EQUAL 64)
  message(FATAL_ERROR "Invalid diagnostic product identity")
endif()
string(HEX "FORESIGHT_DIAGNOSTIC_NATIVE_ID:v1:${DIAGNOSTIC_NATIVE_ID}:end" _marker)
string(HEX "FORESIGHT_DIAGNOSTIC_NATIVE_ID:v1:" _prefix)
foreach(_product IN ITEMS "${DIAGNOSTIC_SUPPORT}" "${DIAGNOSTIC_LAUNCHER}")
  if(IS_SYMLINK "${_product}" OR NOT EXISTS "${_product}" OR IS_DIRECTORY "${_product}")
    message(FATAL_ERROR "Diagnostic linked product unavailable")
  endif()
  file(SIZE "${_product}" _size)
  if(_size LESS 1 OR _size GREATER 67108864)
    message(FATAL_ERROR "Diagnostic linked product size refused")
  endif()
  file(READ "${_product}" _bytes HEX)
  string(REGEX MATCHALL "00${_marker}00" _markers "${_bytes}")
  list(LENGTH _markers _count)
  string(REGEX MATCHALL "00${_prefix}" _prefixes "${_bytes}")
  list(LENGTH _prefixes _prefix_count)
  if(NOT _count EQUAL 1 OR NOT _prefix_count EQUAL 1)
    message(FATAL_ERROR "Diagnostic linked product identity mismatch")
  endif()
endforeach()
file(WRITE "${DIAGNOSTIC_STATE}" "{\"schema\":1,\"available\":true,\"native_id\":\"${DIAGNOSTIC_NATIVE_ID}\"}\n")
