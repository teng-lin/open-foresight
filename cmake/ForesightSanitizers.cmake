include_guard(GLOBAL)
option(FORESIGHT_SANITIZERS "Run native tests with AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
option(FORESIGHT_THREAD_SANITIZER "Run native tests with ThreadSanitizer in a separate build" OFF)
if(FORESIGHT_SANITIZERS AND FORESIGHT_THREAD_SANITIZER)
  message(FATAL_ERROR "ThreadSanitizer cannot be combined with AddressSanitizer")
endif()
if(FORESIGHT_SANITIZERS OR FORESIGHT_THREAD_SANITIZER)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    message(FATAL_ERROR "Native sanitizers require GCC or Clang")
  endif()
  if(FORESIGHT_THREAD_SANITIZER)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      message(FATAL_ERROR "The ThreadSanitizer gate requires Clang")
    endif()
    add_compile_options(-fsanitize=thread -shared-libsan -fno-omit-frame-pointer)
    add_link_options(-fsanitize=thread -shared-libsan)
  else()
    add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
    add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      add_compile_options(-shared-libasan)
      add_link_options(-shared-libasan)
    endif()
  endif()
endif()
